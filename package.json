{
  "name": "cortico-world-calendar-reminder",
  "version": "1.1.1",
  "type": "module",
  "description": "日历提醒：从系统日历（Linux/Windows/macOS）或 CalDAV / ICS 订阅提取日程并按时提醒。支持点任务单次提醒、区间任务多种重复频率与结束提醒。",
  "license": "MIT",
  "author": "ThermalEng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThermalEng/cortico-world-calendar-reminder.git"
  },
  "homepage": "https://github.com/ThermalEng/cortico-world-calendar-reminder#readme",
  "bugs": {
    "url": "https://github.com/ThermalEng/cortico-world-calendar-reminder/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "calendar",
    "reminder",
    "caldav",
    "ics",
    "icalendar",
    "schedule",
    "notification"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "tags": [
      "companion"
    ],
    "describe": "describe.json",
    "displayName": "日历提醒",
    "icon": "icon.svg",
    "webUiClient": "dist/webui.js",
    "locales": {
      "zh": {
        "displayName": "日历提醒",
        "description": "从系统日历（Linux/Windows/macOS）或 CalDAV 订阅提取日程并按时提醒。支持点任务单次提醒，以及区间任务（只提醒一次/每天/每小时/每15分钟）和结束时提醒。"
      },
      "en": {
        "displayName": "Calendar Reminder",
        "description": "Extract calendar events from your OS calendar (Linux/Windows/macOS) or CalDAV subscriptions and deliver timely reminders. Supports one-time point events and configurable interval event reminders plus end-of-event notifications."
      }
    }
  },
  "files": [
    "src",
    "dist",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
